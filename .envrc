# direnv: Grinn GenioBoard-700 workspace
PATH_add bin
PATH_add "$HOME/.local/bin"   # pipx apps (genio-flash, genio-config)

# Serial console defaults (override in .envrc.local, e.g. when ttyUSB numbering changes)
export BOARD_TTY="${BOARD_TTY:-/dev/genio-board}"
export BOARD_BAUD="${BOARD_BAUD:-921600}"
export BOARD_DOCS="$PWD/grinn-genio-700-sbc-docs"

source_env_if_exists .envrc.local
