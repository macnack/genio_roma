   224,
   224
  ]
 },
 "calibration_num": 10,
 "calibration_method": "ema",
 "default_loader": {
  "dataset_path": "/home/maciej/Github/geniu_aeroma/data/calib_probe_SYNTHETIC",
  "file_extensions": [
   "jpeg",
   "jpg",
   "png",
   "JPEG"
  ],
