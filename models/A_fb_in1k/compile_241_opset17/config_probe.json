{
  "inputs": {
    "input": [
      1,
      3,
      224,
      224
    ]
  },
  "calibration_method": "ema",
  "calibration_num": 10,
  "quantization_device": "cpu",
  "default_loader": {
    "dataset_path": "/home/maciej/Github/geniu_aeroma/data/calib_probe_SYNTHETIC",
    "file_extensions": [
      "jpg"
    ],
    "preprocessings": [
      {
        "resize": {
          "mode": "torchvision",
          "width": 256,
          "height": 256,
          "interpolation": "BICUBIC"
        }
      },
      {
        "centercrop": {
          "width": 224,
          "height": 224
        }
      },
      {
        "normalize": {
          "mean": [
            0.485,
            0.456,
            0.406
          ],
          "std": [
            0.229,
            0.224,
            0.225
          ]
        }
      },
      {
        "transpose": {
          "axis": [
            0,
            3,
            1,
            2
          ]
        }
      }
    ]
  }
}